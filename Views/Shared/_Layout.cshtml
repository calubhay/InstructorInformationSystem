<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Instructor Information System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="app-layout">
        <!-- Sidebar Backdrop for mobile -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Left Vertical Sidebar -->
        <aside class="app-sidebar" id="appSidebar">
            <!-- Sidebar Header / Brand -->
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Account" asp-action="Dashboard">
                    <span class="brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                        </svg>
                    </span>
                    <span class="brand-text">
                        <span class="brand-title">Instructor System</span>
                    </span>
                </a>
                <button type="button" class="sidebar-close-btn d-lg-none" id="sidebarCloseBtn" aria-label="Close sidebar">
                    &times;
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                <div class="sidebar-section-title">NAVIGATION</div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="sidebar-link @(currentController == "Account" && currentAction == "Dashboard" ? "active" : "")" asp-controller="Account" asp-action="Dashboard">
                        <span class="sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                        </span>
                        <span class="sidebar-text">Dashboard</span>
                    </a>

                    <a class="sidebar-link @(currentController == "Instructor" ? "active" : "")" asp-controller="Instructor" asp-action="Index">
                        <span class="sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </span>
                        <span class="sidebar-text">Instructors</span>
                    </a>
                }
                else
                {
                    <a class="sidebar-link @(currentController == "Account" && currentAction == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">
                        <span class="sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                <polyline points="10 17 15 12 10 7"></polyline>
                                <line x1="15" y1="12" x2="3" y2="12"></line>
                            </svg>
                        </span>
                        <span class="sidebar-text">Login</span>
                    </a>

                    <a class="sidebar-link @(currentController == "Account" && currentAction == "Register" ? "active" : "")" asp-controller="Account" asp-action="Register">
                        <span class="sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="8.5" cy="7" r="4"></circle>
                                <line x1="20" y1="8" x2="20" y2="14"></line>
                                <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                        </span>
                        <span class="sidebar-text">Create account</span>
                    </a>
                }
            </nav>

            <!-- Sidebar User Profile / Footer at bottom -->
            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="sidebar-user-card">
                        <div class="sidebar-user-avatar">
                            @(User.Identity.Name != null && User.Identity.Name.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="sidebar-user-details">
                            <span class="sidebar-user-greeting">Hi, @User.Identity.Name</span>
                            <span class="sidebar-user-role">Administrator</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form">
                        <button type="submit" class="sidebar-logout-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Log out</span>
                        </button>
                    </form>
                }
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="app-main">
            <!-- Topbar Header -->
            <header class="app-topbar">
                <button type="button" class="sidebar-toggle-btn d-lg-none" id="sidebarToggleBtn" aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <div class="topbar-brand-mobile d-lg-none">
                    Instructor System
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="topbar-right ms-auto d-flex align-items-center gap-3">
                        <span class="topbar-user-name small text-muted d-none d-sm-inline">@User.Identity.Name</span>
                    </div>
                }
            </header>

            <!-- Page Body -->
            <main class="page-shell container-fluid px-3 px-sm-4 px-lg-5">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <div class="container-fluid px-3 px-sm-4 px-lg-5">
                    &copy; @DateTime.Now.Year Instructor Information System
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
